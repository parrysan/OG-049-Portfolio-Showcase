  "scene": {
    "label": "Stage types, one per step",
    "title": "Each stage type, in action.",
    "steps": [
      {
        "title": "Decode · Unpack a name",
        "note": "Each letter or part rises in with its meaning beside it, set in the brand's own typeface.",
        "stage": {
          "type": "decode",
          "items": [
            {
              "glyph": "m",
              "word": "monoclonal"
            },
            {
              "glyph": "Ab",
              "word": "antibody"
            },
            {
              "glyph": "V",
              "word": "vaccine",
              "accent": true
            }
          ],
          "caption": "Example: mAbV."
        },
        "badge": "decode",
        "bestFor": "The brief, when the name itself carries the idea."
      },
      {
        "title": "Anatomy · Explain a mark",
        "note": "The artwork sits large while leader lines draw in from each feature to its label.",
        "stage": {
          "type": "anatomy",
          "src": "../../portfolio-mabv/assets/vector/mabv-logo.svg",
          "alt": "The mAbV mark",
          "box": {
            "left": 14,
            "top": 8,
            "height": 84
          },
          "callouts": [
            {
              "text": "Feature one, drawn from the artwork",
              "dot": [
                504,
                263
              ],
              "edge": 588
            },
            {
              "text": "Feature two, on the outline",
              "dot": [
                588,
                392
              ]
            },
            {
              "text": "Feature three, inside the mark",
              "dot": [
                375,
                502
              ],
              "edge": 520
            }
          ],
          "caption": "Example: the mAbV shield."
        },
        "badge": "anatomy",
        "bestFor": "The core design idea, when it lives inside the artwork."
      },
      {
        "title": "Converge · Show the routes not taken",
        "note": "The explored options sit side by side, then slide together into the one that was chosen.",
        "stage": {
          "type": "converge",
          "items": [
            {
              "src": "../../portfolio-str/assets/logo-routes/v000.svg",
              "label": "Route V0"
            },
            {
              "src": "../../portfolio-str/assets/logo-routes/v001.svg",
              "label": "Route V1"
            },
            {
              "src": "../../portfolio-str/assets/logo-routes/v002.svg",
              "label": "Route V2"
            },
            {
              "src": "../../portfolio-str/assets/logo-routes/v004.svg",
              "label": "Route V4"
            },
            {
              "src": "../../portfolio-str/assets/logo-routes/v005.svg",
              "label": "Route V5"
            }
          ],
          "final": {
            "src": "../../portfolio-str/assets/vector/logo-str.svg",
            "alt": "The final STR mark"
          },
          "caption": "Example: STR's logo routes."
        },
        "badge": "converge",
        "bestFor": "Logo routes, layout options or concepts (four to six)."
      },
      {
        "title": "Flood · Make a colour decision",
        "note": "The old colour floods into the new one, with the spec set large: Pantone, HEX, RGB.",
        "stage": {
          "type": "flood",
          "from": "#00B4A6",
          "to": "#0047BB",
          "was": "Before: teal",
          "eyebrow": "Pantone",
          "big": "2728 C",
          "sub": "Cobalt Blue",
          "specs": [
            {
              "k": "HEX",
              "v": "#0047BB"
            },
            {
              "k": "RGB",
              "v": "0 · 71 · 187"
            }
          ],
          "caption": "Example: teal to cobalt."
        },
        "badge": "flood",
        "bestFor": "A colour change with a clear before and after."
      },
      {
        "title": "Palette · Present a palette",
        "note": "Swatches grow up from the baseline, each with its name and value.",
        "stage": {
          "type": "palette",
          "swatches": [
            {
              "name": "Primary",
              "hex": "#0A5F8A"
            },
            {
              "name": "Dark",
              "hex": "#084A6D"
            },
            {
              "name": "Light",
              "hex": "#3D8AB5"
            },
            {
              "name": "Tint",
              "hex": "#E6F2F7"
            },
            {
              "name": "Secondary",
              "hex": "#0D9488"
            },
            {
              "name": "Trust",
              "hex": "#059669"
            }
          ],
          "caption": "Example: STR's six colours."
        },
        "badge": "palette",
        "bestFor": "A full palette, or several colours with roles."
      },
      {
        "title": "Pair · Connect artwork to the real thing",
        "note": "The artwork on the left, the photo of it in the world on the right.",
        "stage": {
          "type": "pair",
          "art": {
            "src": "../../portfolio-mabv/assets/vector/mabv-logo-lockup-cn-en.svg",
            "alt": "Bilingual mAbV lockup"
          },
          "note": "Artwork on the left, the real thing on the right.",
          "photo": {
            "src": "../../portfolio-mabv/assets/img/office-1.jpg",
            "alt": "mAbV reception sign"
          }
        },
        "badge": "pair",
        "bestFor": "A deliverable next to its real application."
      },
      {
        "title": "Window · Show a live screen",
        "note": "A real screenshot in a browser frame. The optional size ladder renders the actual logo files at real sizes.",
        "stage": {
          "type": "window",
          "src": "../../portfolio-mabv/assets/img/ds-logo.jpg",
          "alt": "mAbV design system logo page",
          "ladder": {
            "label": "Size ladder",
            "split": 2,
            "items": [
              {
                "src": "../../portfolio-mabv/assets/vector/mabv-logo-simple.svg",
                "size": 16
              },
              {
                "src": "../../portfolio-mabv/assets/vector/mabv-logo-simple.svg",
                "size": 24
              },
              {
                "src": "../../portfolio-mabv/assets/vector/mabv-logo.svg",
                "size": 32
              },
              {
                "src": "../../portfolio-mabv/assets/vector/mabv-logo.svg",
                "size": 48
              },
              {
                "src": "../../portfolio-mabv/assets/vector/mabv-logo.svg",
                "size": 72
              }
            ]
          },
          "caption": "Example: mAbV design system."
        },
        "badge": "window",
        "bestFor": "Websites and design-system pages; add a size ladder for marks."
      },
      {
        "title": "Responsive · Prove it works on a phone",
        "note": "The desktop page in a browser frame, with the phone version sliding up beside it.",
        "stage": {
          "type": "responsive",
          "desktop": {
            "src": "../../portfolio-str/assets/img/pdp.jpg",
            "alt": "STR product page on desktop"
          },
          "phone": {
            "src": "../../portfolio-str/assets/img/pdp-phone.jpg",
            "alt": "STR product page on a phone"
          },
          "caption": "Example: STR product page."
        },
        "badge": "responsive",
        "bestFor": "Any site where mobile matters."
      },
      {
        "title": "Rules · State the rules",
        "note": "Do and Don't side by side; the Don'ts are struck through.",
        "stage": {
          "type": "rules",
          "do": [
            "“Synthetic QS-21-Api demonstrates equivalent activity.”",
            "“Secure supply chain.”"
          ],
          "dont": [
            "“Our amazing product boosts vaccines like never before.”",
            "“The best adjuvant on the market.”"
          ],
          "caption": "Example: STR writing rules."
        },
        "badge": "rules",
        "bestFor": "Writing style, logo usage, accessibility do's and don'ts."
      },
      {
        "title": "Manifest · List the handover",
        "note": "A screen with a row of facts underneath: files, formats and counts stagger in.",
        "stage": {
          "type": "manifest",
          "src": "../../portfolio-mabv/assets/img/ds-brand-kit.jpg",
          "alt": "mAbV brand kit page",
          "items": [
            {
              "k": "Digital",
              "v": "4 SVG · 4 PNG"
            },
            {
              "k": "Print",
              "v": "4 PDF · 4 EPS"
            },
            {
              "k": "Social",
              "v": "1 SVG · 1 PNG"
            }
          ],
          "caption": "Example: mAbV brand kit."
        },
        "badge": "manifest",
        "bestFor": "Brand kits, file sets, component libraries."
      },
      {
        "title": "Fan · Prove it's in use",
        "note": "Two to four portraits fan out on the brand's deep colour.",
        "stage": {
          "type": "fan",
          "photos": [
            {
              "src": "../../portfolio-str/assets/img/products-phone.jpg",
              "alt": "STR products on a phone"
            },
            {
              "src": "../../portfolio-mabv/assets/img/office-2.jpg",
              "alt": "mAbV reception"
            },
            {
              "src": "../../portfolio-str/assets/img/pdp-phone.jpg",
              "alt": "STR product page on a phone"
            }
          ],
          "caption": "Example: phones and an office photo."
        },
        "badge": "fan",
        "bestFor": "Real-world photos or phone screens: the proof step."
      },
      {
        "title": "Image · Show anything else",
        "note": "Any single image, contained or covering the stage, on any background.",
        "stage": {
          "type": "image",
          "src": "../../portfolio-str/assets/img/catalogue-manager.jpg",
          "alt": "STR catalogue manager prototype",
          "fit": "cover",
          "pos": "top left",
          "caption": "Example: STR catalogue manager."
        },
        "badge": "image",
        "bestFor": "Diagrams, infographics, a single strong picture."
      }
    ],
    "numbered": true
  },
